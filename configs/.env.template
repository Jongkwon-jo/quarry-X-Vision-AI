# 데이터 파이프라인 환경변수
# 사용: 이 파일을 .env로 복사하고 값을 채워넣은 뒤 python-dotenv로 로드
# 또는 시스템 환경변수로 등록.
#
# 보안: .env 파일을 절대 git에 커밋하지 마세요. (.gitignore 등록 필수)

# Roboflow API 키
ROBOFLOW_API_KEY=

# 학습 서버 FTP 비밀번호
FTP_PASSWORD=

# 학습 서버 SSH 비밀번호
SSH_PASSWORD=

# 선택: 수집 폴더 오버라이드
# COLLECTION_SOURCE_ROOT=C:\Users\User\Desktop\Project\VISION_AI
# COLLECTION_SOURCE_SUBDIR=20260428

# 선택: Roboflow 프로젝트명 오버라이드
# ROBOFLOW_PROJECT=20260428

# 선택: 시간 기반 중복 필터 옵션
# DEDUP_ENABLED=true                # true / false
# DEDUP_STRATEGY=time_gap           # time_gap 또는 time_window
# DEDUP_MIN_GAP_SEC=30              # time_gap 모드에서 최소 간격 (초)
# DEDUP_WINDOW_SEC=60               # time_window 모드에서 윈도우 크기 (초)
